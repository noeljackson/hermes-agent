    {
      "cases": [
        {
          "input": "Default",
          "normalized": "default",
          "valid_after_normalize": true,
          "validation_error": null
        },
        {
          "input": " Coder ",
          "normalized": "coder",
          "valid_after_normalize": true,
          "validation_error": null
        },
        {
          "input": "Team_A",
          "normalized": "team_a",
          "valid_after_normalize": true,
          "validation_error": null
        },
        {
          "input": "",
          "normalized": null,
          "valid_after_normalize": false,
          "validation_error": "profile name cannot be empty"
        },
        {
          "input": "bad/name",
          "normalized": "bad/name",
          "valid_after_normalize": false,
          "validation_error": "Invalid profile name 'bad/name'. Must match [a-z0-9][a-z0-9_-]{0,63}"
        },
        {
          "input": "tmp",
          "normalized": "tmp",
          "valid_after_normalize": false,
          "validation_error": "Profile name 'tmp' is reserved \u2014 it collides with either the Hermes installation itself or a common system binary.  Pick a different name."
        },
        {
          "input": "profile",
          "normalized": "profile",
          "valid_after_normalize": true,
          "validation_error": null
        },
        {
          "input": "valid-01",
          "normalized": "valid-01",
          "valid_after_normalize": true,
          "validation_error": null
        },
        {
          "input": "UPPER",
          "normalized": "upper",
          "valid_after_normalize": true,
          "validation_error": null
        },
        {
          "input": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
          "normalized": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
          "valid_after_normalize": false,
          "validation_error": "Invalid profile name 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'. Must match [a-z0-9][a-z0-9_-]{0,63}"
        }
      ],
      "name": "profile_name_validation"
    },
